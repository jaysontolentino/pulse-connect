# Pooled connection used by the app (Neon pooler or PgBouncer).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler:5432/DATABASE?sslmode=require"
# Direct (non-pooler) connection used only for migrations. Optional locally;
# required for production builds, which run `prisma migrate deploy`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_mapbox_token_here"
